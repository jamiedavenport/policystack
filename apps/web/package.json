		"blume": "1.5.3"
	},
	"devDependencies": {
		"@types/node": "^25.3.5",
		"astro": "7.2.9",
		"gray-matter": "4.0.3",
		"node-html-parser": "7.0.1",
		"vite-plus": "catalog:"
	}
