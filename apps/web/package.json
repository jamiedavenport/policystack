{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/prepare.mjs && blume dev --port 3000",
		"build": "node scripts/prepare.mjs && blume build && node scripts/finalize.mjs",
		"preview": "blume preview",
